# Copy to .env and fill in. Never commit .env.
GOOGLE_API_KEY=
ADMIN_TOKEN=change-me

# Optional: SMS through Twilio. Without these, messages are recorded and shown as "Logged only".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# or, instead of TWILIO_FROM:
# TWILIO_MESSAGING_SERVICE_SID=

# Optional: phone-call (IVR) access. Needs TWILIO_AUTH_TOKEN above and a public https URL.
PUBLIC_BASE_URL=
IVR_LANGUAGE=hi-IN
# Local curl testing ONLY. Never set this on a server reachable from the internet.
# IVR_ALLOW_UNSIGNED=1
